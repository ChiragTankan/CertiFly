rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // --- Campaigns Collection ---
    match /campaigns/{campaignId} {
      allow get: if request.auth != null 
        && resource.data.createdBy == request.auth.uid;

      allow list: if request.auth != null 
        && resource.data.createdBy == request.auth.uid;

      allow create: if request.auth != null 
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null 
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.status != 'completed'
        && resource.data.status != 'failed';

      allow delete: if request.auth != null 
        && resource.data.createdBy == request.auth.uid
        && resource.data.status != 'sending';
    }

    // --- Recipients Subcollection ---
    match /campaigns/{campaignId}/recipients/{recipientId} {
      allow get: if request.auth != null 
        && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid;

      allow list: if request.auth != null 
        && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid;

      allow create: if request.auth != null 
        && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid;

      allow update: if request.auth != null 
        && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid;

      allow delete: if request.auth != null 
        && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.createdBy == request.auth.uid;
    }
  }
}
